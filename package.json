{
  "name": "@intlify/utils",
  "version": "1.2.0",
  "description": "Collection of i18n utilities",
  "keywords": [
    "i18n",
    "internationalization",
    "intlify",
    "utilities"
  ],
  "homepage": "https://github.com/intlify/utils#readme",
  "bugs": {
    "url": "https://github.com/intlify/utils/issues"
  },
  "license": "MIT",
  "author": {
    "name": "kazuya kawaguchi",
    "email": "kawakazu80@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intlify/utils.git"
  },
  "funding": "https://github.com/sponsors/kazupon",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./h3": {
      "types": "./dist/h3.d.ts",
      "import": "./dist/h3.mjs",
      "require": "./dist/h3.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.mjs",
      "require": "./dist/hono.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "build:docs": "typedoc --excludeInternal",
    "fix": "vp check --fix && knip --fix --no-exit-code",
    "lint": "vp check && knip",
    "play:browser": "pnpm run --filter example-browser dev",
    "play:bun": "pnpm run --filter example-bun dev",
    "play:node": "pnpm run --filter example-node dev",
    "prepare": "vp config --no-agent",
    "release": "bumpp",
    "test": "pnpm run test:unit",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "pnpm run --color \"/^test:e2e:/\"",
    "test:e2e:browser": "pnpm run --filter example-browser test",
    "test:e2e:bun": "pnpm run --filter example-bun test",
    "test:e2e:node": "pnpm run --filter example-node test",
    "test:unit": "vp test"
  },
  "devDependencies": {
    "@kazupon/vp-config": "^1.1.0",
    "@types/node": "^24.12.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:vitest",
    "bumpp": "^12.0.0",
    "cookie-es": "^1.2.3",
    "gh-changelogen": "^2.0.2",
    "h3": "^1.15.5",
    "hono": "^4.0.0",
    "knip": "^6.44.1",
    "pkg-pr-new": "^0.0.92",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite-plus": "catalog:vitest",
    "vitest": "catalog:vitest"
  },
  "engines": {
    "node": ">= 22"
  },
  "packageManager": "pnpm@10.34.9"
}
